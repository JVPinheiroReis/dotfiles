	email = joaovictorpinheiro2007@gmail.com

[init]
    defaultBranch = master

[advice]
    detachedHead = false

[core]
    excludesFile = ~/.gitignore_global
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = side-by-side line-numbers navigate dark decorations
    syntax-theme = Dracula
    plus-style = syntax "#003800"
    minus-style = syntax "#3f0001"
    true-color = always

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan ul

[delta "line-numbers"]
    line-numbers-left-style = cyan
    line-numbers-right-style = cyan
    line-numbers-minus-style = 124
    line-numbers-plus-style = 28

[merge]
    conflicStyle = zdiff3

[alias]
    a = add
    aa = add --all
    br = branch
    brr = branch --remote
    bl = blame
    ps = push
    pl = pull
    c = commit
    ca = commit --amend
    cl = clean
    co = checkout
    d = diff
    ds = diff --staged
    f = fetch
    i = init
    l = log
    m = merge
    r = remote
    rs = reset
    rb = rebase
    rl = reflog
    rt = restore
    rv = revert
    s = status
    sh = show
    t = tag

[push]
    autoSetupRemote = true
    default = current
